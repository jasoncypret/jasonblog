{#
  Design-system layout.

  Pages using this layout load ds.css ONLY — not site.css. That is deliberate:
  the legacy stylesheet ships its own reset and utility classes that collide
  with the design system's element defaults. Migrating a page to the new
  system means switching `layout: layouts/ds.njk` in its front matter.
#}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">

  {#
    Runs before first paint so an explicitly-chosen theme never flashes the
    wrong palette. With no stored choice we set nothing at all and let the
    prefers-color-scheme media query in ds.css decide. Also marks html.js —
    several CSS rules (lazy-image fades, scroll reveals, the hero photo)
    start their elements at opacity:0 only when this class is present, so a
    page with JS disabled or blocked never ends up with content stuck
    invisible: without the class those rules simply don't exist.
  #}
  <script>
    (function () {
      document.documentElement.classList.add("js");
      try {
        var saved = localStorage.getItem("jc-theme");
        if (saved === "dark" || saved === "light") {
          document.documentElement.setAttribute("data-theme", saved);
        }
      } catch (e) { /* private mode — fall back to the OS preference */ }
    })();
  </script>

  <title>{% if title %}{{ title }}{% else %}Jason Cypret{% endif %}</title>
  <meta name="description" content="{{ description or summary }}">
  <meta name="author" content="Jason Cypret">
  <link rel="canonical" href="https://jasoncypret.com{{ page.url }}">

  {# Open Graph / Twitter #}
  <meta property="og:type" content="{% if date %}article{% else %}website{% endif %}">
  <meta property="og:url" content="https://jasoncypret.com{{ page.url }}">
  <meta property="og:title" content="{{ og_title or title }}">
  <meta property="og:description" content="{{ og_description or description or summary }}">
  <meta property="og:image" content="{% if og_image %}{{ og_image }}{% elif open_graph_image %}{{ open_graph_image }}{% elif image %}{{ image }}{% else %}https://jasoncypret.com/media/jason-cypret-og-image.jpg{% endif %}">
  <meta property="og:site_name" content="Jason Cypret">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@JasonCypret">
  <meta name="twitter:creator" content="@JasonCypret">
  <meta name="twitter:title" content="{{ twitter_title or title }}">
  <meta name="twitter:description" content="{{ twitter_description or description or summary }}">
  <meta name="twitter:image" content="{% if og_image %}{{ og_image }}{% elif open_graph_image %}{{ open_graph_image }}{% elif image %}{{ image }}{% else %}https://jasoncypret.com/media/jason-cypret-og-image.jpg{% endif %}">

  <meta name="robots" content="{{ robots or 'index, follow' }}">

  {% if date %}
  <meta property="article:published_time" content="{{ date | dateISO }}">
  <meta property="article:author" content="Jason Cypret">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | dump | safe }},
    "description": {{ (summary or description or "") | dump | safe }},
    "datePublished": "{{ date | dateISO }}",
    "url": "https://jasoncypret.com{{ page.url }}",
    "author": { "@type": "Person", "name": "Jason Cypret" }
  }
  </script>
  {% else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jason Cypret",
    "jobTitle": "Head of Product Experience",
    "description": {{ (description or "") | dump | safe }},
    "url": "https://jasoncypret.com",
    "sameAs": [
      "https://linkedin.com/in/jasoncypret",
      "https://twitter.com/JasonCypret",
      "https://github.com/jasoncypret"
    ]
  }
  </script>
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,200;0,400;0,500;0,600;0,700;0,800;1,400;1,700&display=swap" rel="stylesheet">
  <link rel="icon" href="/media/homepage/JC-logo.svg" type="image/svg+xml">
  <link rel="mask-icon" href="/media/homepage/JC-logo.svg" color="#0400FF">
  <link rel="stylesheet" href="/stylesheets/ds.css">
  <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/feed.xml">
</head>
<body{% if navOnHero %} class="nav-on-hero"{% endif %}>
  <a class="ds-skip" href="#main">Skip to content</a>

  {% from "ds/components.njk" import siteNav, siteFooter %}
  {{ siteNav(home.footer.logo, home.nav, home.social, page.url) }}

  <main id="main">
    {{ content | safe }}
  </main>

  {{ siteFooter(home.footer.logo, home.footer.columns, home.social, home.footer.legal) }}

  {#
    Opt-in page scripts. Only the company case-study pages need the gallery
    lightbox and the AOS reveal animations, so the rest of the site does not
    pay for them. Set `editorialScripts: true` in a page's front matter.
  #}
  {% if editorialScripts %}
    <script src="/javascripts/site.js"></script>
    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        if (window.AOS) AOS.init({ duration: 1000, easing: "ease", once: true, offset: 100 });
      });
    </script>
  {% endif %}

  <script>
    (function () {
      var btn = document.querySelector("[data-theme-toggle]");
      if (!btn) return;
      var root = document.documentElement;
      var mq = window.matchMedia("(prefers-color-scheme: dark)");

      function current() {
        return root.getAttribute("data-theme") || (mq.matches ? "dark" : "light");
      }
      btn.addEventListener("click", function () {
        var next = current() === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("jc-theme", next); } catch (e) {}
      });
      // Track the OS while the visitor has no explicit preference of their own.
      mq.addEventListener("change", function () {
        try { if (!localStorage.getItem("jc-theme")) root.removeAttribute("data-theme"); } catch (e) {}
      });
    })();

    // Transparent nav over the homepage hero — solid again once scrolled
    // past it. Scoped to body.nav-on-hero (see navOnHero in front matter)
    // so no other page's nav is affected.
    (function () {
      if (!document.body.classList.contains("nav-on-hero")) return;
      var onScroll = function () {
        document.body.classList.toggle("is-scrolled", window.scrollY > 24);
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    })();

    // Mute/unmute toggle for autoplaying hero videos — they have to start
    // muted to autoplay at all, this is the only way to actually hear them.
    (function () {
      document.querySelectorAll("[data-video-mute]").forEach(function (btn) {
        var video = btn.previousElementSibling;
        if (!video || video.tagName !== "VIDEO") return;
        btn.addEventListener("click", function () {
          video.muted = !video.muted;
          var unmuted = !video.muted;
          btn.classList.toggle("is-unmuted", unmuted);
          btn.setAttribute("aria-pressed", String(unmuted));
          btn.setAttribute("aria-label", unmuted ? "Mute video" : "Turn on sound");
        });
      });
    })();

    // Lazy-image fade-in system — every img[loading="lazy"] fades in from
    // its placeholder (a brand gradient on .jc-article__image /
    // .jc-showcase__container, a shimmer sweep elsewhere — see the
    // corresponding CSS) once it actually has pixels, instead of popping
    // in whenever the network happens to catch up. Sitewide and generic,
    // not homepage-specific — any page's lazy images get this for free.
    (function () {
      var imgs = document.querySelectorAll('img[loading="lazy"]');
      if (!imgs.length) return;
      imgs.forEach(function (img) {
        if (img.complete && img.naturalWidth > 0) {
          img.classList.add("is-loaded");
          return;
        }
        img.addEventListener("load", function () { img.classList.add("is-loaded"); });
        // A broken image shouldn't sit at opacity:0 forever either.
        img.addEventListener("error", function () { img.classList.add("is-loaded"); });
      });
    })();

    // Scroll reveals — one shared IntersectionObserver for every
    // [data-reveal] element on the page (see _home.scss for the CSS and
    // which elements currently carry the attribute). Generic and
    // sitewide; a page that never adds the attribute pays nothing extra.
    (function () {
      var els = document.querySelectorAll("[data-reveal]");
      if (!els.length) return;
      if (!("IntersectionObserver" in window)) {
        els.forEach(function (el) { el.classList.add("is-revealed"); });
        return;
      }
      var io = new IntersectionObserver(function (entries, observer) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-revealed");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.15, rootMargin: "0px 0px -8% 0px" });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>
</body>
</html>
