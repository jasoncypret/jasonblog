{#
  ARCHIVE — not wired into any page. This is the hand-rolled "glowing
  liquid ring" WebGL shader (built from direct observation of 21st.dev's
  "liquid-shader" demo — no source-recovery route was available on it at
  the time) exactly as it existed before being replaced by a faithful
  vanilla-WebGL port of the real recovered source, once the user spent a
  free 21st.dev view to unlock Component.tsx (Oct 2026). The real
  component turned out to be a 6-step ray-marched nebula with an inverse
  center-vignette — not a boundary-noise ring at all — so this
  from-observation approximation was superseded rather than tuned
  further. Kept here purely as a revert reference. Files under _includes
  are never built into pages, so this is inert.

  v1 (original card photo), v2 (giant grayscale name), v3 (earlier
  fbm-noise shader), v4 (CSS-only blobs + static dot grid), v5
  (fbm-noise domain-warp attempt), v6 (Mesh drift WebGL shader port) and
  v7 (gradient blobs + particle-wave canvas, confirmed the best of the
  prior rounds) are archived separately in their own _hero-vN-archive.njk
  files.

  To restore: paste this markup + script back into index.njk in place of
  the hero section. No CSS changed from v7 — .heroS__canvas in
  _home.scss is shared by v5/v6/v8/v9, only the script differs.
#}

<section class="heroS">
  <canvas class="heroS__canvas" id="heroLiquid" aria-hidden="true"></canvas>
  <div class="heroS__inner">
    <img class="heroS__img" src="{{ home.hero.imageBw }}" alt="Jason Cypret" width="1138" height="1382">

    <div class="heroS__copy">
      <p class="eyebrow">{{ home.hero.eyebrow }}</p>
      <h1 class="heroS__h">I build the interface between <b>humans and AI.</b></h1>
      <p class="heroS__lede">
        <strong>Twenty years and 30+ products shipped</strong> as a product and design executive.
        Today I work as an AI orchestrator: I lead the team, set the direction and write a lot
        of the code myself, so product, design and engineering run as one continuous loop
        instead of three handoffs.
      </p>
      <div class="heroS__actions">
        {{ button(home.hero.ctaLabel, home.hero.ctaUrl, "primary", "md", "rounded", "", "arrow-right") }}
        <a class="inline-link inline-link--onHero" href="#work">See the work <i class="icon-arrow-down" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var cv = document.getElementById("heroLiquid");
    if (!cv) return;
    var gl = cv.getContext("webgl", { preserveDrawingBuffer: false, alpha: false });
    if (!gl) return;

    var vs = "attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}";
    var fs = [
      "precision highp float;",
      "uniform float t;uniform vec2 r;",
      "uniform vec3 uBase;uniform vec3 uColorA;uniform vec3 uColorB;",
      "float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}",
      "float noise(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(hash(i),hash(i+vec2(1,0)),f.x),mix(hash(i+vec2(0,1)),hash(i+vec2(1,1)),f.x),f.y);}",
      "float fbm(vec2 p){float v=0.,a=.5;for(int i=0;i<4;i++){v+=a*noise(p);p*=2.0;a*=.5;}return v;}",
      "void main(){",
      "  vec2 uv=gl_FragCoord.xy/r;",
      "  vec2 auv=(uv-0.5)*vec2(r.x/r.y,1.0);",
      "  vec2 center=vec2(0.42,-0.04)+vec2(sin(t*0.05)*0.07,cos(t*0.04)*0.05);",
      "  vec2 p=auv-center;",
      "  float ang=atan(p.y,p.x);",
      "  float dist=length(p);",
      "  float rad=0.46+(fbm(vec2(cos(ang),sin(ang))*2.2+t*0.03)-0.5)*0.2;",
      "  float d=dist-rad;",
      "  float glow=exp(-abs(d)*10.0)*0.55;",
      "  float fill=smoothstep(0.0,-0.35,d)*0.12;",
      "  float hueMix=0.5+0.5*sin(ang+t*0.05);",
      "  vec3 ringColor=mix(uColorA,uColorB,hueMix);",
      "  vec3 col=mix(uBase,ringColor,clamp(glow+fill,0.0,1.0));",
      "  float mask=smoothstep(0.05,0.6,uv.x);",
      "  col=mix(uBase,col,mask);",
      "  gl_FragColor=vec4(col,1.0);",
      "}"
    ].join("\n");

    function compile(type, src) {
      var s = gl.createShader(type);
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    }
    var pr = gl.createProgram();
    gl.attachShader(pr, compile(gl.VERTEX_SHADER, vs));
    gl.attachShader(pr, compile(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(pr);
    gl.useProgram(pr);

    var buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    var loc = gl.getAttribLocation(pr, "p");
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    var uT = gl.getUniformLocation(pr, "t");
    var uR = gl.getUniformLocation(pr, "r");
    var uBase = gl.getUniformLocation(pr, "uBase");
    var uColorA = gl.getUniformLocation(pr, "uColorA");
    var uColorB = gl.getUniformLocation(pr, "uColorB");

    var DARK = { base: [0.031, 0.031, 0.039], a: [0.169, 0.247, 0.549], b: [0.420, 0.357, 0.651] };
    var LIGHT = { base: [1.0, 1.0, 1.0], a: [0.169, 0.247, 0.549], b: [0.420, 0.357, 0.651] };

    function isDark() {
      var explicit = document.documentElement.getAttribute("data-theme");
      if (explicit === "dark") return true;
      if (explicit === "light") return false;
      return window.matchMedia("(prefers-color-scheme: dark)").matches;
    }

    function resize() {
      var rect = cv.getBoundingClientRect();
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var w = Math.max(1, Math.round(rect.width * dpr));
      var h = Math.max(1, Math.round(rect.height * dpr));
      if (cv.width !== w || cv.height !== h) {
        cv.width = w;
        cv.height = h;
        gl.viewport(0, 0, w, h);
        gl.uniform2f(uR, w, h);
      }
    }
    window.addEventListener("resize", resize);
    resize();

    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var t0 = performance.now();

    function draw() {
      var theme = isDark() ? DARK : LIGHT;
      gl.uniform3f(uBase, theme.base[0], theme.base[1], theme.base[2]);
      gl.uniform3f(uColorA, theme.a[0], theme.a[1], theme.a[2]);
      gl.uniform3f(uColorB, theme.b[0], theme.b[1], theme.b[2]);
      gl.uniform1f(uT, (performance.now() - t0) / 1000);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      if (!reduceMotion) requestAnimationFrame(draw);
    }
    draw();
  })();
</script>
