{#
  ARCHIVE — not wired into any page. This is a snapshot of the "Mesh
  drift" WebGL shader port (tuned across several rounds: muted 3-color
  palette, static grain, bounds-gated cursor spotlight, slowed motion)
  exactly as it existed just before it was abandoned in favor of
  restoring v4's gradient-blob structure with a real particle-wave canvas
  (modeled on 21st.dev's "threejs-particles-waves") replacing the old
  static dot grid (Oct 2026) — after several tuning passes it still
  wasn't landing. Kept here purely as a revert reference. Files under
  _includes are never built into pages, so this is inert.

  v1 (original card photo), v2 (giant grayscale name), v3 (earlier
  fbm-noise shader), v4 (CSS-only blobs + dot grid) and v5 (fbm-noise
  domain-warp attempt) are archived separately in their own
  _hero-vN-archive.njk files.

  To restore: paste this markup + script back into index.njk in place of
  the hero section.
#}

<section class="heroS">
  <canvas class="heroS__canvas" id="heroShader" aria-hidden="true"></canvas>
  <div class="heroS__inner">
    <img class="heroS__img" src="{{ home.hero.imageBw }}" alt="Jason Cypret" width="1138" height="1382">

    <div class="heroS__copy">
      <p class="eyebrow">{{ home.hero.eyebrow }}</p>
      <h1 class="heroS__h">I build the interface between <b>humans and AI.</b></h1>
      <p class="heroS__lede">
        <strong>Twenty years and 30+ products shipped</strong> as a product and design executive.
        Today I work as an AI orchestrator: I lead the team, set the direction and write a lot
        of the code myself, so product, design and engineering run as one continuous loop
        instead of three handoffs.
      </p>
      <div class="heroS__actions">
        {{ button(home.hero.ctaLabel, home.hero.ctaUrl, "primary", "md", "rounded", "", "arrow-right") }}
        <a class="inline-link inline-link--onHero" href="#work">See the work <i class="icon-arrow-down" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var cv = document.getElementById("heroShader");
    if (!cv) return;
    var gl = cv.getContext("webgl", { preserveDrawingBuffer: false, alpha: false });
    if (!gl) return;

    var vs = "attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}";
    var fs = [
      "precision highp float;",
      "uniform float t;uniform vec2 r;uniform vec2 m;",
      "uniform vec3 uColors[3];uniform vec3 uSpot;uniform float uSpotActive;uniform float uIntensity;uniform float uSeed;",
      "float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}",
      "vec3 shade(vec2 uv,vec2 p,float t){",
      "  vec3 acc=uColors[0]*0.15;",
      "  float total=0.15;",
      "  for(int i=0;i<3;i++){",
      "    float fi=float(i);",
      "    vec2 c=vec2(",
      "      sin(t*(0.21+fi*0.071)+fi*2.4+uSeed),",
      "      cos(t*(0.17+fi*0.093)+fi*1.7)",
      "    )*(0.45+uIntensity*0.35);",
      "    float w=exp(-dot(p-c,p-c)*6.0);",
      "    acc+=uColors[i]*w;",
      "    total+=w;",
      "  }",
      "  return acc/total;",
      "}",
      "void main(){",
      "  vec2 uv=gl_FragCoord.xy/r;",
      "  vec2 p=(uv-0.5)*2.0*vec2(r.x/r.y,1.0);",
      "  vec3 col=shade(uv,p,t*0.3);",
      "  float mask=smoothstep(0.05,0.62,uv.x);",
      "  col=mix(uColors[0],col,mask);",
      "  vec2 am=(m-0.5)*2.0*vec2(r.x/r.y,1.0);",
      "  float d=distance(p,am);",
      "  float spot=smoothstep(0.6,0.0,d)*0.3*uSpotActive;",
      "  col+=uSpot*spot;",
      "  col+=(hash(gl_FragCoord.xy)-0.5)*0.055;",
      "  gl_FragColor=vec4(col,1.0);",
      "}"
    ].join("\n");

    function compile(type, src) {
      var s = gl.createShader(type);
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    }
    var pr = gl.createProgram();
    gl.attachShader(pr, compile(gl.VERTEX_SHADER, vs));
    gl.attachShader(pr, compile(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(pr);
    gl.useProgram(pr);

    var buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    var loc = gl.getAttribLocation(pr, "p");
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    var uT = gl.getUniformLocation(pr, "t");
    var uR = gl.getUniformLocation(pr, "r");
    var uM = gl.getUniformLocation(pr, "m");
    var uColors = gl.getUniformLocation(pr, "uColors[0]");
    var uSpot = gl.getUniformLocation(pr, "uSpot");
    var uSpotActive = gl.getUniformLocation(pr, "uSpotActive");
    var uIntensity = gl.getUniformLocation(pr, "uIntensity");
    var uSeed = gl.getUniformLocation(pr, "uSeed");

    var DARK = { colors: [0.031, 0.031, 0.039, 0.169, 0.247, 0.549, 0.420, 0.357, 0.651] };
    var LIGHT = { colors: [1.0, 1.0, 1.0, 0.460, 0.511, 0.707, 0.623, 0.582, 0.773] };
    var SPOT = [0.5, 0.4, 0.85];

    function isDark() {
      var explicit = document.documentElement.getAttribute("data-theme");
      if (explicit === "dark") return true;
      if (explicit === "light") return false;
      return window.matchMedia("(prefers-color-scheme: dark)").matches;
    }

    function resize() {
      var rect = cv.getBoundingClientRect();
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var w = Math.max(1, Math.round(rect.width * dpr));
      var h = Math.max(1, Math.round(rect.height * dpr));
      if (cv.width !== w || cv.height !== h) {
        cv.width = w;
        cv.height = h;
        gl.viewport(0, 0, w, h);
        gl.uniform2f(uR, w, h);
      }
    }
    window.addEventListener("resize", resize);
    resize();

    var target = { x: 0.5, y: 0.5 };
    var smooth = { x: 0.5, y: 0.5 };
    var activeTarget = 0;
    var active = 0;
    window.addEventListener("mousemove", function (e) {
      var rect = cv.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;
      var inBounds = e.clientX >= rect.left && e.clientX <= rect.right &&
        e.clientY >= rect.top && e.clientY <= rect.bottom;
      activeTarget = inBounds ? 1 : 0;
      if (!inBounds) return;
      var mx = (e.clientX - rect.left) / rect.width;
      var my = 1 - (e.clientY - rect.top) / rect.height;
      target.x = (mx - 0.5) * (rect.width / rect.height) + 0.5;
      target.y = my;
    }, { passive: true });

    var seed = Math.random() * 10.0;
    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var t0 = performance.now();

    function draw() {
      var theme = isDark() ? DARK : LIGHT;
      gl.uniform3fv(uColors, new Float32Array(theme.colors));
      gl.uniform3f(uSpot, SPOT[0], SPOT[1], SPOT[2]);
      gl.uniform1f(uIntensity, 0.6);
      gl.uniform1f(uSeed, seed);
      active += (activeTarget - active) * 0.08;
      gl.uniform1f(uSpotActive, active);
      smooth.x += (target.x - smooth.x) * 0.045;
      smooth.y += (target.y - smooth.y) * 0.045;
      gl.uniform2f(uM, smooth.x, smooth.y);
      gl.uniform1f(uT, (performance.now() - t0) / 1000);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      if (!reduceMotion) requestAnimationFrame(draw);
    }
    draw();
  })();
</script>
