{#
  ARCHIVE — not wired into any page. This is a snapshot of the live WebGL
  shader hero exactly as it existed just before it was swapped for the
  simpler CSS-only drifting-gradient version (Oct 2026) — the fbm noise
  field read as "too busy" and tanked nav legibility, plus the WebGL
  canvas made the nav-over-hero treatment harder than it needed to be.
  Kept here purely as a revert reference. Files under _includes are never
  built into pages, so this is inert.

  v1 (original card photo) and v2 (giant grayscale name) are archived
  separately in _hero-v1-archive.njk / _hero-v2-archive.njk.

  To restore: paste this markup + script back into index.njk in place of
  the hero section, and pull the matching CSS back from
  src/stylesheets/ds/_archive-hero-v3.scss into _home.scss.
#}

{# ---------------------------------------------------------------- Hero --
   A live WebGL shader field (the Worlds purple/blue, recolored per theme)
   behind a cascading headline and the B&W cutout. -- #}
<section class="heroS">
  <canvas class="heroS__canvas" id="heroShader" aria-hidden="true"></canvas>
  <img class="heroS__img" src="{{ home.hero.imageBw }}" alt="Jason Cypret" width="1138" height="1382">
  <div class="heroS__fade" aria-hidden="true"></div>

  <div class="heroS__copy">
    <p class="eyebrow">{{ home.hero.eyebrow }}</p>
    <h1 class="heroS__h"><span>I build the interface</span><span>between humans</span><span>and AI.</span></h1>
    <p class="heroS__lede"><strong>Twenty years and 30+ products shipped.</strong> Today I work as an AI orchestrator — I lead the team, set direction and write a lot of the code myself.</p>
    <div class="heroS__actions">
      {{ button(home.hero.ctaLabel, home.hero.ctaUrl, "primary", "md", "rounded", "", "arrow-right") }}
      <a class="inline-link inline-link--onHero" href="#work">See the work <i class="icon-arrow-down" aria-hidden="true"></i></a>
    </div>
  </div>

  {% if latest %}
    <a class="heroS__latest" href="{{ latest.url }}">
      {% if latest.data.image %}<img src="{{ latest.data.image }}" alt="" loading="lazy">{% endif %}
      <span>
        <span class="heroS__latestCap">Latest from the blog <span class="heroS__dot">·</span> {{ latest.date | dateReadable }}</span>
        <b>{{ latest.data.title }} <i class="icon-arrow-right" aria-hidden="true"></i></b>
      </span>
    </a>
  {% endif %}
</section>

<script>
  /* Live hero background — a slow-drifting fractal-noise field in the
     Worlds purple/blue. Ported from the design exploration; the only
     real addition is theme-awareness (the original was dark-only) and
     making the canvas track its actual rendered size instead of a fixed
     1440x900 frame. Scoped to this page: no canvas, no cost elsewhere. */
  (function () {
    var cv = document.getElementById("heroShader");
    if (!cv) return;
    var gl = cv.getContext("webgl", { preserveDrawingBuffer: false, alpha: false });
    if (!gl) return;

    var vs = "attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}";
    var fs = [
      "precision highp float;",
      "uniform float t;uniform vec2 r;",
      "uniform vec3 uBase;uniform vec3 uPurple;uniform vec3 uBlue;uniform vec3 uOrange;",
      "float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}",
      "float n(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(h(i),h(i+vec2(1,0)),f.x),mix(h(i+vec2(0,1)),h(i+vec2(1,1)),f.x),f.y);}",
      "float fbm(vec2 p){float v=0.,a=.5;for(int i=0;i<5;i++){v+=a*n(p);p*=2.02;a*=.5;}return v;}",
      "void main(){vec2 uv=gl_FragCoord.xy/r;vec2 q=uv*vec2(r.x/r.y,1.)*1.6;",
      "float f=fbm(q+vec2(t*.06,-t*.04)+1.4*fbm(q*1.3-t*.05));",
      "float mask=smoothstep(.2,.85,uv.x)*(.55+.45*smoothstep(0.,.8,uv.y));",
      "vec3 c=mix(uBlue,uPurple,smoothstep(.35,.75,f));",
      "c=mix(c,uOrange,smoothstep(.68,.9,f)*.3*smoothstep(.6,1.,uv.x));",
      "c*=.92;",
      "float k=smoothstep(.22,.72,f)*mask;",
      "vec3 col=mix(uBase,c,k);",
      "col+=(h(gl_FragCoord.xy+t)-.5)*.025;",
      "gl_FragColor=vec4(col,1.);}"
    ].join("\n");

    function compile(type, src) {
      var s = gl.createShader(type);
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    }
    var pr = gl.createProgram();
    gl.attachShader(pr, compile(gl.VERTEX_SHADER, vs));
    gl.attachShader(pr, compile(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(pr);
    gl.useProgram(pr);

    var buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    var loc = gl.getAttribLocation(pr, "p");
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    var uT = gl.getUniformLocation(pr, "t");
    var uR = gl.getUniformLocation(pr, "r");
    var uBase = gl.getUniformLocation(pr, "uBase");
    var uPurple = gl.getUniformLocation(pr, "uPurple");
    var uBlue = gl.getUniformLocation(pr, "uBlue");
    var uOrange = gl.getUniformLocation(pr, "uOrange");

    // Same hues both themes — only how much they're cut with the canvas
    // color changes, so dark mode reads as glow-on-black and light mode
    // as the same aurora softened onto white.
    var DARK = { base: [0.031, 0.031, 0.039], purple: [0.357, 0.231, 0.918], blue: [0.106, 0.247, 0.847], orange: [1.0, 0.5, 0.3] };
    var LIGHT = { base: [1.0, 1.0, 1.0], purple: [0.498, 0.4, 0.936], blue: [0.303, 0.413, 0.881], orange: [1.0, 0.61, 0.454] };

    function isDark() {
      var explicit = document.documentElement.getAttribute("data-theme");
      if (explicit === "dark") return true;
      if (explicit === "light") return false;
      return window.matchMedia("(prefers-color-scheme: dark)").matches;
    }

    function resize() {
      var rect = cv.getBoundingClientRect();
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var w = Math.max(1, Math.round(rect.width * dpr));
      var h = Math.max(1, Math.round(rect.height * dpr));
      if (cv.width !== w || cv.height !== h) {
        cv.width = w;
        cv.height = h;
        gl.viewport(0, 0, w, h);
        gl.uniform2f(uR, w, h);
      }
    }
    window.addEventListener("resize", resize);
    resize();

    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var t0 = performance.now();

    function draw() {
      var theme = isDark() ? DARK : LIGHT;
      gl.uniform3f(uBase, theme.base[0], theme.base[1], theme.base[2]);
      gl.uniform3f(uPurple, theme.purple[0], theme.purple[1], theme.purple[2]);
      gl.uniform3f(uBlue, theme.blue[0], theme.blue[1], theme.blue[2]);
      gl.uniform3f(uOrange, theme.orange[0], theme.orange[1], theme.orange[2]);
      gl.uniform1f(uT, 20 + (performance.now() - t0) / 1000);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      if (!reduceMotion) requestAnimationFrame(draw);
    }
    draw();
  })();
</script>
