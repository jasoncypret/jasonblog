<nav class="nav">
  <div class="nav-container">
    <a class="nav-logo" href="/">
      <div class="nav-avatar">
        <img src="/media/homepage/JC-logo.svg" class="nav-avatar-img lazyload" alt="Jason Cypret" loading="lazy">
      </div>  
    </a>
    
    <ul class="nav-menu">
      {% if site.navigation %}
        {% for item in site.navigation %}
          <li class="nav-menu-item">
            <a href="{{ item.url }}" class="nav-link {{ item.title }}">{{ item.title | capitalize }}</a>
          </li>
        {% endfor %}
      {% endif %}
    </ul>
    <ul class="nav-menu social">
      {% if site.professional_links %}
        {% for link in site.professional_links %}
          <li class="nav-menu-item nav-social">
            <a href="{{ link.url }}" class="nav-social-link" target="_blank" title="{{ link.title | capitalize }}">
              <i class="icon-{{ link.title }}"></i>
            </a>
          </li>
        {% endfor %}
      {% endif %}
    </ul>
    
    <button class="nav-toggle" aria-label="Toggle navigation">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const navToggle = document.querySelector('.nav-toggle');
  const navContainer = document.querySelector('.nav-container');
  
  if (navToggle && navContainer) {
    navToggle.addEventListener('click', function() {
      navContainer.classList.toggle('nav-open');
      navToggle.classList.toggle('active');
      
      // Toggle aria-expanded for accessibility
      const isExpanded = navContainer.classList.contains('nav-open');
      navToggle.setAttribute('aria-expanded', isExpanded);
    });
    
    // Close menu when clicking on nav links (mobile)
    const navLinks = document.querySelectorAll('.nav-link');
    navLinks.forEach(link => {
      link.addEventListener('click', function() {
        navContainer.classList.remove('nav-open');
        navToggle.classList.remove('active');
        navToggle.setAttribute('aria-expanded', 'false');
      });
    });
    
    // Close menu when clicking outside (mobile)
    document.addEventListener('click', function(event) {
      if (!navContainer.contains(event.target) && navContainer.classList.contains('nav-open')) {
        navContainer.classList.remove('nav-open');
        navToggle.classList.remove('active');
        navToggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
});
</script>
