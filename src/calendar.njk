---
layout: base
permalink: /calendar/
page_classes: calendar
---

<div class="blog-container">
  <div class="blog-header">
    <div class="blog-header-content">
      <h1 class="blog-title">Articles by Year</h1>
      <p class="blog-subtitle">Browse all articles organized chronologically</p>
      <a href="/blog/" class="btn btn--link small no-shadow pl-0">
        <i class='icon-arrow-left'></i> Back to Blog
      </a>
    </div>
    
    <div class="blog-sidebar">
      <h3>Browse Content</h3>
      
      <div class="blog-sidebar-content-cards">
        <div class="content-card active">
          <a href="/calendar/" class="content-link">
            <i class='icon icon-calendar-alt'></i>
            <div class="title">Articles by Year</div>
          </a>
        </div>
        
        <div class="content-card">
          <a href="/tags/" class="content-link">
            <i class='icon icon-tag'></i>
            <div class="title">Articles by Category</div>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="blog-content">
    <div class="blog-articles">
      <div class="calendar-years">
        {% if collections.articlesByYear %}
        {% set years = collections.articlesByYear | keys | sort | reverse %}
        {% for year in years %}
          {% set yearArticles = collections.articlesByYear[year] %}
          <div class="calendar-year-section">
            <div class="calendar-year-header">
              <h2 class="calendar-year-title">
                <a href="/calendar/{{ year }}/">{{ year }}</a>
                <span class="article-count">({{ yearArticles.length }} article{% if yearArticles.length != 1 %}s{% endif %})</span>
              </h2>
            </div>
            
            <div class="calendar-articles-grid">
              <div class="row">
                {% for article in yearArticles | limit(6) %}
                  <div class="col-lg-4 col-md-6">
                    <article class="blog-article blog-article--grid blog-article--calendar">
                      <div class="article-image">
                        {% if article.data.image %}
                          <a href="{{ article.url }}">
                            <img src="{{ article.data.image }}" alt="{{ article.data.title }}" class="lazyload" loading="lazy">
                          </a>
                        {% endif %}
                      </div>
                      
                      <div class="article-content">
                        <small class="article-date">{{ article.date | dateFormat }}</small>
                        
                        <h3 class="article-title">
                          <a href="{{ article.url }}">{{ article.data.title }}</a>
                        </h3>
                        
                      </div>
                    </article>
                  </div>
                {% endfor %}
              </div>
            </div>
            
            {% if yearArticles.length > 6 %}
              <div class="calendar-view-all">
                <a href="/calendar/{{ year }}/" class="btn btn--black btn--small">
                  View all {{ year }} articles <i class='icon-arrow-right'></i>
                </a>
              </div>
            {% endif %}
          </div>
        {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</div>
