---
layout: ds
title: Articles by Year — Jason Cypret
description: Browse all articles organized chronologically.
permalink: /calendar/
---
{% from "ds/browse.njk" import browseCards %}

<div class="pagehead">
  <div class="pagehead__main">
    <p class="eyebrow">Writing</p>
    <h1 class="pagehead__title">Articles by year</h1>
    <p class="pagehead__sub">Browse everything chronologically.</p>
    <a class="pagehead__back" href="/blog/"><i class="icon-arrow-left" aria-hidden="true"></i> Back to blog</a>
  </div>
  {{ browseCards("calendar") }}
</div>

<div class="yearlist">
  {% set years = collections.articlesByYear | keys | sort | reverse %}
  {% for year in years %}
    {% set yearArticles = collections.articlesByYear[year] %}
    <section class="yeargroup">
      <h2 class="yeargroup__year">
        <a href="/calendar/{{ year }}/">{{ year }}</a>
        <span style="font-size: var(--text-body-sm); font-weight: var(--weight-medium); color: var(--text-secondary);">
          {{ yearArticles.length }} article{% if yearArticles.length != 1 %}s{% endif %}
        </span>
      </h2>
      {% for article in yearArticles %}
        <a class="postrow" href="{{ article.url }}">
          <span class="postrow__date">{{ article.date | dateReadable }}</span>
          <span>
            <span class="postrow__t">{{ article.data.title }}</span>
            {% if article.data.summary %}<span class="postrow__s">{{ article.data.summary }}</span>{% endif %}
          </span>
        </a>
      {% endfor %}
    </section>
  {% endfor %}
</div>
