---
layout: ds
pagination:
  data: collections.years
  size: 1
  alias: year
permalink: /calendar/{{ year }}/index.html
eleventyComputed:
  title: "Archive for {{ year }} — Jason Cypret"
  description: "Every article published in {{ year }}."
---
{% from "ds/browse.njk" import browseCards %}
{% set yearArticles = collections.articlesByYear[year] %}

<div class="pagehead">
  <div class="pagehead__main">
    <p class="eyebrow">Archive</p>
    <h1 class="pagehead__title">{{ year }}</h1>
    <p class="pagehead__sub">{{ yearArticles.length }} article{% if yearArticles.length != 1 %}s{% endif %} published this year.</p>
    <a class="pagehead__back" href="/calendar/"><i class="icon-arrow-left" aria-hidden="true"></i> All years</a>
  </div>
  {{ browseCards("calendar") }}
</div>

<div class="yearlist">
  <section class="yeargroup">
    {% for article in yearArticles %}
      <a class="postrow" href="{{ article.url }}">
        <span class="postrow__date">{{ article.date | dateReadable }}</span>
        <span>
          <span class="postrow__t">{{ article.data.title }}</span>
          {% if article.data.summary %}<span class="postrow__s">{{ article.data.summary }}</span>{% endif %}
        </span>
      </a>
    {% endfor %}
  </section>
</div>
