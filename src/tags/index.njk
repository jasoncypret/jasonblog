---
layout: ds
title: Categories — Jason Cypret
description: Browse all articles organized by topic and theme.
permalink: /tags/
---
{% from "ds/browse.njk" import browseCards %}

<div class="pagehead">
  <div class="pagehead__main">
    <p class="eyebrow">Writing</p>
    <h1 class="pagehead__title">Categories</h1>
    <p class="pagehead__sub">Browse all articles organized by topic and theme.</p>
    <a class="pagehead__back" href="/blog/"><i class="icon-arrow-left" aria-hidden="true"></i> Back to blog</a>
  </div>

  {{ browseCards("tags") }}
</div>

<div class="tagcloud">
  {% for tag in collections.tagList %}
    {% set tagArticles = collections.articles | filterByTag(tag) %}
    <a class="jc-tagtile" href="/tags/{{ tag | slug }}/">
      <span class="jc-tagtile__name">{{ tag }}</span>
      <span class="jc-tagtile__count">{{ tagArticles.length or 0 }} article{% if tagArticles.length != 1 %}s{% endif %}</span>
    </a>
  {% endfor %}
</div>
