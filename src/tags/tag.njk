---
layout: ds
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/tags/{{ tag | slug }}/index.html"
eleventyComputed:
  title: "Articles tagged '{{ tag }}' — Jason Cypret"
  description: "Every article filed under {{ tag }}."
---
{% from "ds/browse.njk" import browseCards %}
{% from "ds/components.njk" import articleCard %}
{% set tagArticles = collections.articles | filterByTag(tag) %}

<div class="pagehead">
  <div class="pagehead__main">
    <p class="eyebrow">Category</p>
    <h1 class="pagehead__title">{{ tag }}</h1>
    <p class="pagehead__sub">{{ tagArticles.length }} article{% if tagArticles.length != 1 %}s{% endif %} filed under this topic.</p>
    <a class="pagehead__back" href="/tags/"><i class="icon-arrow-left" aria-hidden="true"></i> Back to categories</a>
  </div>

  {{ browseCards("tags") }}
</div>

{% if tagArticles.length %}
  <div class="listing">
    {% for article in tagArticles %}
      {{ articleCard({
        title: article.data.title,
        url: article.url,
        date: article.date | dateReadable,
        summary: article.data.summary,
        image: article.data.image,
        tags: article.data.tags
      }, "grid") }}
    {% endfor %}
  </div>
{% else %}
  <p class="listing__empty">No articles under this tag yet.</p>
{% endif %}
