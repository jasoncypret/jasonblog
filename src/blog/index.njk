---
layout: ds
title: Blog — Jason Cypret
description: Reflections on building better teams, systems, and products.
pagination:
  data: collections.articles
  size: 8
  alias: articles
permalink: "blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber }}/{% endif %}index.html"
---
{% from "ds/browse.njk" import browseCards %}
{% from "ds/components.njk" import articleCard, button %}

<div class="pagehead">
  <div class="pagehead__main">
    <p class="eyebrow">Writing</p>
    {% if pagination.pageNumber > 0 %}
      <h1 class="pagehead__title">Articles continued</h1>
      <p class="pagehead__sub">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}.</p>
    {% else %}
      <h1 class="pagehead__title">Blog</h1>
      <p class="pagehead__sub">Reflections on building better teams, systems, and products.</p>
    {% endif %}
  </div>

  {{ browseCards("") }}
</div>

{% set featured = articles | limit(2) %}
{% set rest = articles | offset(2) %}

{% if featured.length %}
  <div class="listing listing--featured">
    {% for article in featured %}
      {{ articleCard({
        title: article.data.title,
        url: article.url,
        date: article.date | dateReadable,
        summary: article.data.summary,
        image: article.data.image,
        tags: article.data.tags
      }, "featured") }}
    {% endfor %}
  </div>
{% endif %}

{% if rest.length %}
  <div class="listing">
    {% for article in rest %}
      {{ articleCard({
        title: article.data.title,
        url: article.url,
        date: article.date | dateReadable,
        summary: article.data.summary,
        image: article.data.image,
        tags: article.data.tags
      }, "grid") }}
    {% endfor %}
  </div>
{% endif %}

{% if not featured.length %}
  <p class="listing__empty">No articles yet.</p>
{% endif %}

{% if pagination.pages.length > 1 %}
  <nav class="jc-pagination" aria-label="Pagination">
    {% if pagination.previousPageHref %}
      {{ button("Previous articles", pagination.previousPageHref, "secondary", "md", "pill", "arrow-left") }}
    {% endif %}
    {% if pagination.nextPageHref %}
      {{ button("More articles", pagination.nextPageHref, "primary", "md", "pill", "", "arrow-right") }}
    {% endif %}
  </nav>
{% endif %}
