---
layout: ds
title: Experience — Jason Cypret
description: Twenty years of UX, product and development experience across Worlds, Power, BloomBoard, Brainspace and more.
permalink: /resume/
---
{% from "ds/components.njk" import button, iconButton %}

<header class="resume__head">
  <div>
    <img class="resume__avatar" src="{{ resume.intro.avatar }}" alt="Jason Cypret" loading="eager">
    <h1 class="resume__name">Jason Cypret</h1>
    <p class="resume__tagline">
      20+ years of UX, product
      <span style="white-space: nowrap;">&amp; development experience</span>
    </p>
    <div class="resume__contact">
      <a class="resume__email" href="mailto:{{ resume.intro.email }}">{{ resume.intro.email }}</a>
      {% for s in home.social %}{{ iconButton(s.title, s.label or s.title, s.url, "sm") }}{% endfor %}
    </div>
    <div class="resume__actions">
      {{ button("Get in touch", "mailto:" + resume.intro.email, "primary", "md", "rounded", "", "arrow-right") }}
      {# Hidden for now — the PDF is out of date and this live page covers it. Re-enable by uncommenting.
      {{ button("Download resume", resume.intro.resumePdf, "secondary", "md", "rounded", "download", "", true) }}
      #}
    </div>
  </div>
  <img class="resume__portrait" src="{{ resume.intro.portrait }}" alt="Jason Cypret speaking" loading="lazy">
</header>

<div class="resume">
  <section class="resume__section">
    <p class="resume__label">Work history</p>
    <div class="resume__roles">
      {% for role in resume.roles %}
        <div class="resume__role{{ ' resume__role--grouped' if role.positions }}">
          <div class="resume__aside">
            {% if role.logo %}
              {% set logoMarkup %}
                <img class="resume__logo resume__logo--light{{ ' resume__logo--' + role.logoClass if role.logoClass }}" src="{{ role.logo }}" alt="{{ role.company }}" loading="lazy">
                {% if role.logoDark %}
                  <img class="resume__logo resume__logo--dark{{ ' resume__logo--' + role.logoClass if role.logoClass }}" src="{{ role.logoDark }}" alt="" aria-hidden="true" loading="lazy">
                {% endif %}
              {% endset %}
              {% if role.href %}
                <a href="{{ role.href }}" target="_blank" rel="noopener">{{ logoMarkup | safe }}</a>
              {% else %}
                {{ logoMarkup | safe }}
              {% endif %}
            {% endif %}
          </div>
          <div>
            {% if role.positions %}
              <div class="resume__titlerow">
                <h2 class="resume__title">
                  {% if role.href %}
                    <a href="{{ role.href }}" target="_blank" rel="noopener">{{ role.company }}</a>
                  {% else %}{{ role.company }}{% endif %}
                </h2>
                <span class="resume__years">{{ role.years }}</span>
              </div>
              <div class="resume__positions">
                {% for position in role.positions %}
                  <div class="resume__position">
                    <div class="resume__positionrow">
                      <h3 class="resume__position__title">{{ position.title }}</h3>
                      <span class="resume__position__years">{{ position.years }}</span>
                    </div>
                    <p class="resume__desc">{{ position.description }}</p>
                  </div>
                {% endfor %}
              </div>
            {% else %}
              <div class="resume__titlerow">
                <h2 class="resume__title">{{ role.title }}</h2>
                <span class="resume__years">{{ role.years }}</span>
              </div>
              <p class="resume__company">
                {% if role.href %}
                  <a href="{{ role.href }}" target="_blank" rel="noopener">{{ role.company }}</a>
                {% else %}{{ role.company }}{% endif %}
              </p>
              <p class="resume__desc">{{ role.description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </section>
</div>
